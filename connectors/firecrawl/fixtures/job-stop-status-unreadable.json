{
    "name": "job-stop-status-unreadable",
    "description": "A job stopped mid-run whose final meter cannot be read: the DELETE lands but the status read answers 503. Stop is UNRESOLVED, never silently free.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "success": true,
                    "id": "JOB1",
                    "url": "{{request.url}}/JOB1"
                }
            }
        },
        {
            "req": {
                "method": "DELETE",
                "url": "{{request.url}}/JOB1"
            },
            "res": {
                "status": 200,
                "body": {
                    "success": true,
                    "status": "cancelled"
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.url}}/JOB1"
            },
            "res": {
                "status": 503,
                "body": {
                    "success": false,
                    "error": "Service unavailable"
                }
            }
        }
    ]
}
