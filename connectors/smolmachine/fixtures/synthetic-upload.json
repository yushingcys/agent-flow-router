{
    "name": "synthetic-upload",
    "description": "SYNTHETIC upload chain: the file rides base64 on stdin of one POST /exec whose guest command decodes it and prints the written size.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.origin}}/v1/machines/mach-1/exec",
                "body": {
                    "command": [
                        "sh",
                        "-c",
                        "mkdir -p \"$(dirname \"$1\")\" && base64 -d > \"$1\" && wc -c < \"$1\"",
                        "sh",
                        "/workspace/hello.txt"
                    ],
                    "stdin": "aGVsbG8=",
                    "timeoutSeconds": 25
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "stdout": "5\n",
                    "stderr": "",
                    "exitCode": 0,
                    "durationMs": 8,
                    "machineId": "mach-1"
                }
            }
        }
    ]
}
