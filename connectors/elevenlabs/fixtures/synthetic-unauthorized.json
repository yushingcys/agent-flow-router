{
    "name": "synthetic-unauthorized",
    "description": "SYNTHETIC 401 in ElevenLabs' {detail: {status, message}} error shape (docs error examples).",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 401,
                "body": {
                    "detail": {
                        "status": "invalid_api_key",
                        "message": "Invalid API key"
                    }
                }
            }
        }
    ]
}
