{
    "name": "synthetic-get-message",
    "description": "SYNTHETIC get-message chain from the documented Message shape. The literal url pins the percent-encoding of an address inbox_id and an angle-bracket message_id.",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "https://api.agentmail.to/v0/inboxes/agent%40agentmail.to/messages/%3Cm1%40mail.example.com%3E"
            },
            "res": {
                "status": 200,
                "body": {
                    "inbox_id": "agent@agentmail.to",
                    "thread_id": "th-1",
                    "message_id": "<m1@mail.example.com>",
                    "labels": ["received", "unread"],
                    "timestamp": "2026-10-27T00:00:00Z",
                    "from": "Ana <ana@example.com>",
                    "to": ["agent@agentmail.to"],
                    "subject": "Pricing",
                    "text": "What does the team plan cost?",
                    "extracted_text": "What does the team plan cost?",
                    "size": 1024,
                    "updated_at": "2026-10-27T00:00:00Z",
                    "created_at": "2026-10-27T00:00:00Z"
                }
            }
        }
    ]
}
