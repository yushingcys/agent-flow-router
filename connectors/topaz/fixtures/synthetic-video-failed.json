{
    "name": "synthetic-video-failed",
    "description": "SYNTHETIC: the request is accepted, then fails in processing. Topaz refunds failed requests; the run settles a synthesized 500 with the status (and the requestId) as data and zero usage.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "requestId": "5d6e7f80-91a2-4b3c-8d4e-5f60718293a4",
                    "estimates": {
                        "cost": [
                            4,
                            6
                        ],
                        "time": [
                            60,
                            120
                        ]
                    }
                }
            }
        },
        {
            "req": {
                "method": "PATCH",
                "url": "{{request.origin}}/video/5d6e7f80-91a2-4b3c-8d4e-5f60718293a4/accept"
            },
            "res": {
                "status": 202,
                "body": {
                    "message": "Request accepted; the source will be fetched from external storage."
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/video/5d6e7f80-91a2-4b3c-8d4e-5f60718293a4/status"
            },
            "res": {
                "status": 200,
                "body": {
                    "status": "failed",
                    "message": "failed",
                    "progress": 10,
                    "estimates": {
                        "cost": [
                            4,
                            6
                        ],
                        "time": [
                            60,
                            120
                        ]
                    },
                    "errorCode": "PROCESSING_FAILURE"
                }
            }
        }
    ]
}
