{
    "name": "synthetic-release-busy",
    "description": "SYNTHETIC release refused with 409 while the number is still active (on a call): the op must retry, not conclude.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.origin}}/v1/numbers/num_1/release"
            },
            "res": {
                "status": 409,
                "body": {
                    "detail": "Number is on an active call"
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/numbers/num_1"
            },
            "res": {
                "status": 200,
                "body": {
                    "id": "num_1",
                    "phone_number": "+14155550100",
                    "country": "US",
                    "number_type": "local",
                    "status": "active",
                    "agent_id": "agt_1",
                    "cost": 3.0,
                    "balance_remaining": 41.5
                }
            }
        }
    ]
}
