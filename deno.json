{
    "workspace": [
        "./shared/app-config",
        "./shared/logging",
        "./shared/core",
        "./shared/compiler",
        "./shared/testing",
        "./engine"
    ],
    "tasks": {
        "check": "deno check .",
        "lint": "deno lint",
        "fmt": "deno fmt",
        "test": "deno test --unstable-kv --allow-read --allow-env --allow-write --allow-run=git",
        "test:live": "deno test --allow-read --allow-env --allow-write --allow-net",
        "compiler:compile": "deno run --allow-read --allow-write --allow-env --allow-run=git scripts/compile.ts",
        "engine:run": "deno run --unstable-kv --allow-read --allow-write --allow-env --allow-net --allow-run=git scripts/run.ts",
        "catalog": "deno run --allow-read --allow-write --allow-env --allow-run=git scripts/catalog.ts",
        "record": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run=git scripts/record.ts",
        "version:check": "deno run --allow-read --allow-run=git scripts/version-check.ts",
        "ids:check": "deno run --allow-read --allow-write --allow-env --allow-run=git scripts/ids-check.ts",
        "webhook": "deno run --unstable-kv --allow-read --allow-write --allow-env --allow-net --allow-run=git,cloudflared,tailscale scripts/webhook.ts",
        "apify:scaffold": "deno run --allow-read --allow-write --allow-env --allow-net=api.apify.com scripts/apify-scaffold.ts",
        "defillama:scaffold": "deno run --allow-read --allow-write --allow-env --allow-net=api-docs.defillama.com,api.monid.ai scripts/defillama-scaffold.ts",
        "tikhub:scaffold": "deno run --allow-read --allow-write --allow-env --allow-run=deno,git --allow-net=api.tikhub.io,api.monid.ai scripts/tikhub-scaffold.ts",
        "engine:estimate": "deno run --allow-read --allow-write --allow-env scripts/estimate.ts",
        "build": "deno run --allow-read --allow-write --allow-env --allow-run=git scripts/compile.ts --force",
        "drift": "deno run --allow-read --allow-write --allow-env --allow-net=api.apify.com --allow-run=deno,git scripts/drift.ts",
        "mcp": "deno run -q --allow-read --allow-write --allow-env --allow-net --allow-run=git mcp/main.ts",
        "boundary:check": "deno run --allow-read --allow-run=git scripts/boundary-check.ts"
    },
    "imports": {
        "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
        "@shared/compiler": "./shared/compiler/mod.ts",
        "@shared/testing": "./shared/testing/mod.ts",
        "@agent-flow/connector-engine": "./engine/mod.ts",
        "@modelcontextprotocol/sdk/": "npm:/@modelcontextprotocol/sdk@1.32.1/",
        "zod": "npm:zod@4.3.6",
        "ajv": "npm:ajv@^8.18.0",
        "ajv/": "npm:/ajv@^8.18.0/",
        "ajv-formats": "npm:ajv-formats@^3.0.1",
        "typescript": "npm:typescript@^5.9.2",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/semver": "jsr:@std/semver@^1.0.4",
        "@std/path": "jsr:@std/path@^1.1.4",
        "@std/fs": "jsr:@std/fs@^1.0.14",
        "@std/yaml": "jsr:@std/yaml@^1.0.12",
        "@shared/app-config": "./shared/app-config/mod.ts",
        "@shared/core": "./shared/core/mod.ts",
        "@shared/logging": "./shared/logging/mod.ts",
        "pino": "npm:pino@^10.3.1",
        "canonicalize": "npm:canonicalize@^2.1.0"
    },
    "fmt": {
        "indentWidth": 4,
        "proseWrap": "preserve",
        "useTabs": false,
        "exclude": [
            ".output/",
            ".impeccable/",
            "shared/testing/goldens/"
        ]
    },
    "lint": {
        "exclude": [
            ".output/"
        ],
        "rules": {
            "exclude": [
                "no-slow-types",
                "no-explicit-any",
                "no-unused-vars",
                "verbatim-module-syntax",
                "require-await"
            ]
        }
    },
    "exclude": [
        ".output/"
    ]
}
